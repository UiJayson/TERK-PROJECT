  "devDependencies": {
    "@netlify/functions": "^3.1.10",
    "@netlify/vite-plugin": "^2.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
