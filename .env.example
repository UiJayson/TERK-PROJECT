# =============================================================================
# AI Business OS — Environment Variables (Milestone 11)
# Copy to `.env` for local dev, or set in Netlify: Site settings → Environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (REQUIRED)
# PostgreSQL connection string for persistence.
# Get it at: https://supabase.com/dashboard → Project → Settings → Database
# Use the PgBouncer / Transaction pooler URL (port 6543).
# -----------------------------------------------------------------------------
# REQUIRED
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# OPTIONAL — accepted aliases (only one is needed)
# SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# AUTH (REQUIRED in production)
# Session signing (JWT). Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
# REQUIRED (production) | OPTIONAL (local dev — dev fallback used)
AUTH_SECRET=your-auth-secret-min-32-chars

# OPTIONAL — encrypts stored channel tokens (WhatsApp/Instagram access
# tokens). Falls back to AUTH_SECRET if unset, so it's not required, but
# setting a dedicated key means rotating AUTH_SECRET won't also break
# decryption of already-stored tokens. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=your-secret-encryption-key-min-32-chars

# OPTIONAL — default workspace for admin endpoints (default: default)
DEFAULT_WORKSPACE_ID=default

# OPTIONAL — bearer token for /api/admin/* (default: dev-admin-change-me locally)
ADMIN_TOKEN=your-admin-bearer-token

# OPTIONAL — observability alert recipient
ADMIN_ALERT_EMAIL=alerts@yourdomain.com

# -----------------------------------------------------------------------------
# ANTHROPIC / AI (REQUIRED when AI_PROVIDER=anthropic)
# Get API key at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
# OPTIONAL — anthropic | openai | netlify (default: anthropic)
AI_PROVIDER=anthropic

# OPTIONAL — override default chat model
AI_MODEL=claude-3-5-sonnet-20241022

# REQUIRED when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — required for embeddings when using Anthropic, or as primary provider
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — Netlify AI Gateway base URL (required when AI_PROVIDER=netlify)
# Get at: Netlify Dashboard → Site → AI → Gateway
OPENAI_BASE_URL=https://your-site.netlify.app/.netlify/ai

# OPTIONAL — embedding model (default: text-embedding-3-small)
AI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# WHATSAPP / Meta (OPTIONAL — REQUIRED for webhook signature verification in production)
# Get App Secret at: https://developers.facebook.com → Your App → Settings → Basic
# -----------------------------------------------------------------------------
# OPTIONAL — either WHATSAPP_APP_SECRET or META_APP_SECRET is accepted
WHATSAPP_APP_SECRET=your-meta-app-secret
# META_APP_SECRET=your-meta-app-secret

# -----------------------------------------------------------------------------
# PAYSTACK (OPTIONAL — required only when Paystack billing is enabled)
# Get keys at: https://dashboard.paystack.com/#/settings/developers
# Note: current billing implementation uses Stripe; add Paystack when integrated.
# -----------------------------------------------------------------------------
# OPTIONAL — format: sk_test_... or sk_live_...
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — format: pk_test_... or pk_live_...
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — Paystack webhook signature secret
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — USD→NGN rate for converting plan prices (USD) to naira when
# charging via Paystack one-off amounts. Defaults to 1600. Only used when a
# Paystack plan CODE is not configured (plan codes carry their own price).
PAYSTACK_USD_TO_NGN=1600

# -----------------------------------------------------------------------------
# RESEND (OPTIONAL)
# Get API key at: https://resend.com/api-keys
# Verify sending domain at: Resend → Domains
# -----------------------------------------------------------------------------
# OPTIONAL — if unset, emails are logged to console instead of sent
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — sender address (must use a verified domain in production)
NOTIFICATION_FROM_EMAIL=AI Business OS <notifications@yourdomain.com>

# -----------------------------------------------------------------------------
# SENTRY (OPTIONAL)
# Get DSN at: Sentry → Project Settings → Client Keys (DSN)
# -----------------------------------------------------------------------------
# OPTIONAL — format: https://[key]@[org].ingest.sentry.io/[project-id]
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# -----------------------------------------------------------------------------
# STRIPE (OPTIONAL — current billing provider)
# Get at: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
# OPTIONAL
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# DEPLOYMENT (OPTIONAL — auto-set by Netlify)
# -----------------------------------------------------------------------------
SITE_URL=https://your-site.netlify.app

# Netlify system variables (auto-injected — do not set manually):
# URL, DEPLOY_URL, DEPLOY_PRIME_URL, NODE_ENV, CONTEXT
